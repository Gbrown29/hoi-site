<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Invoice</title>
  <link rel="stylesheet" href="file://<%= __dirname %>/public/css/invoice-style.css">
</head>
<body>
  <div class="invoice-container">
    <header>
      <div class="logo">
        <img src="https://yourdomain.com/logo.png" alt="Logo">
        <h1>INVOICE</h1>
      </div>
      <div class="bill-to">
        <p><strong>BILL TO:</strong><br>
        <%= customerName %><br>
        <%= customerPhone %><br>
        <%= customerAddress %></p>
      </div>
      <div class="invoice-meta">
        <p>Invoice No: <%= invoiceNumber %><br>
        Invoice Date: <%= invoiceDate %></p>
      </div>
    </header>

    <table>
      <thead>
        <tr><th>Item Description</th><th>Qty</th><th>Price</th><th>Total</th></tr>
      </thead>
      <tbody>
        <% items.forEach(item => { %>
          <tr>
            <td><%= item.name %></td>
            <td><%= item.quantity %></td>
            <td>$<%= item.price.toFixed(2) %></td>
            <td>$<%= (item.quantity * item.price).toFixed(2) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <section class="summary">
      <p>Subtotal: $<%= subtotal.toFixed(2) %></p>
      <p>Tax: 0%</p>
      <p><strong>Total: $<%= subtotal.toFixed(2) %></strong></p>
    </section>

    <section class="footer">
      <p>Account Name: Akshar Gulati</p>
      <p>Phone: 610-800-3227</p>
      <p>Email: info@hoipa.com</p>
      <p>Site: hoipa.com</p>
      <p>Address: 244 Shoemaker Rd, Pottstown, PA 19464</p>
    </section>
  </div>
</body>
</html>
